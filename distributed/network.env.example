# Copy to distributed/network.env (git-ignored) on BOTH machines and edit.
# Both machines must use the same ROS_DOMAIN_ID and the same RMW.

export ROS_DOMAIN_ID=42

# Static IPs of the two machines on the router
export LAPTOP_IP=192.168.1.10
export JETSON_IP=192.168.1.20

# SUBNET = normal LAN discovery (multicast + static peers below).
# If discovery is flaky, set OFF to use ONLY the static peers (pure unicast).
export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# Optional: force one RMW on both machines (must match!). Leave commented to
# use the Jazzy default.
# export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
