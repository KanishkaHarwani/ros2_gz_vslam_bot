<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <!-- Toggles (set from launch: stereo_mode:=stereo|mono, enable_gps:=true|false).
         They switch the *sensors* on/off; the hardware stays on the robot. -->
    <xacro:arg name="enable_right_camera" default="true"/>
    <xacro:arg name="enable_gps"          default="false"/>

    <xacro:include filename="properties.xacro"/>
    <xacro:include filename="links.xacro"/>
    <xacro:include filename="materials.xacro"/>
    <xacro:include filename="joints.xacro"/>
    <xacro:include filename="gazebo_materials.xacro"/>
    <xacro:include filename="gazebo_controls.xacro"/>
    <xacro:include filename="gazebo_sensors.xacro"/>

</robot>
