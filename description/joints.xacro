<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- =========================================== -->
    <!-- ============== DRIVE WHEELS =============== -->
    <!-- =========================================== -->
    <joint name="l_wheel_joint" type="continuous">
        <origin xyz="0 ${wheel_y} 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="l_wheel_link"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <joint name="r_wheel_joint" type="continuous">
        <origin xyz="0 ${-wheel_y} 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="r_wheel_link"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <!-- =========================================== -->
    <!-- ================= CASTER ================== -->
    <!-- =========================================== -->
    <joint name="caster_joint" type="fixed">
        <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="caster_link"/>
    </joint>

    <!-- =========================================== -->
    <!-- ============== STEREO CAMERAS ============= -->
    <!-- =========================================== -->
    <joint name="stereo_bar_joint" type="fixed">
        <origin xyz="${bar_x} 0 ${bar_z}" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="stereo_bar_link"/>
    </joint>

    <xacro:macro name="camera_joints" params="side y">
        <joint name="cam_${side}_joint" type="fixed">
            <origin xyz="${cam_dx} ${y} 0" rpy="0 0 0"/>
            <parent link="stereo_bar_link"/>
            <child link="cam_${side}_link"/>
        </joint>
        <joint name="cam_${side}_optical_joint" type="fixed">
            <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
            <parent link="cam_${side}_link"/>
            <child link="cam_${side}_optical_frame"/>
        </joint>
    </xacro:macro>

    <xacro:camera_joints side="left"  y="${stereo_baseline/2}"/>
    <xacro:camera_joints side="right" y="${-stereo_baseline/2}"/>

    <!-- =========================================== -->
    <!-- ================ IMU / GPS ================ -->
    <!-- =========================================== -->
    <joint name="imu_joint" type="fixed">
        <origin xyz="${imu_x} 0 ${imu_z}" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="imu_link"/>
    </joint>

    <joint name="gps_joint" type="fixed">
        <origin xyz="${gps_x} 0 ${gps_z}" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="gps_link"/>
    </joint>

</robot>
