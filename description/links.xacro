<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- All visuals/collisions are primitives, so the package no longer needs
         any STL meshes (and the IGN_GAZEBO_RESOURCE_PATH workaround is gone). -->

    <!-- =========================================== -->
    <!-- ================ CHASSIS ================== -->
    <!-- =========================================== -->
    <link name="base_link">
        <inertial>
            <origin xyz="${chassis_x} 0 ${chassis_z}" rpy="0 0 0"/>
            <mass value="${chassis_mass}"/>
            <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
        </inertial>
        <visual>
            <origin xyz="${chassis_x} 0 ${chassis_z}" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="desert_tan"/>
        </visual>
        <collision>
            <origin xyz="${chassis_x} 0 ${chassis_z}" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
    </link>

    <!-- =========================================== -->
    <!-- ================= WHEELS ================== -->
    <!-- =========================================== -->
    <!-- Wheel frame origin is the wheel centre (no inner-face offset). -->
    <xacro:macro name="wheel" params="prefix">
        <link name="${prefix}_wheel_link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="${wheel_mass}"/>
                <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" w="${wheel_width}"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>

    <xacro:wheel prefix="l"/>
    <xacro:wheel prefix="r"/>

    <!-- =========================================== -->
    <!-- ============== FRONT CASTER =============== -->
    <!-- =========================================== -->
    <link name="caster_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${caster_mass}"/>
            <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
        </inertial>
        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </collision>
    </link>

    <!-- =========================================== -->
    <!-- ============= STEREO CAMERA BAR =========== -->
    <!-- =========================================== -->
    <link name="stereo_bar_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.15"/>
            <xacro:box_inertia m="0.15" x="0.03" y="${bar_length}" z="0.03"/>
        </inertial>
        <visual>
            <geometry>
                <box size="0.03 ${bar_length} 0.03"/>
            </geometry>
            <material name="gray"/>
        </visual>
    </link>

    <xacro:macro name="camera_link" params="side">
        <link name="cam_${side}_link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.05"/>
                <xacro:box_inertia m="0.05" x="0.02" y="0.03" z="0.03"/>
            </inertial>
            <visual>
                <geometry>
                    <box size="0.02 0.03 0.03"/>
                </geometry>
                <material name="green"/>
            </visual>
        </link>
        <!-- Optical frame (REP-103: z forward, x right, y down). Image and
             camera_info headers use this frame. -->
        <link name="cam_${side}_optical_frame"/>
    </xacro:macro>

    <xacro:camera_link side="left"/>
    <xacro:camera_link side="right"/>

    <!-- =========================================== -->
    <!-- ==================== IMU ================== -->
    <!-- =========================================== -->
    <link name="imu_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.02"/>
            <xacro:box_inertia m="0.02" x="0.03" y="0.02" z="0.005"/>
        </inertial>
        <visual>
            <geometry>
                <box size="0.03 0.02 0.005"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <!-- =========================================== -->
    <!-- ==================== GPS ================== -->
    <!-- =========================================== -->
    <!-- The antenna hardware is always part of the robot (so the size budget
         is always checked with it). Only the *sensor* is toggled, via the
         enable_gps xacro arg. -->
    <link name="gps_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.05"/>
            <xacro:cylinder_z_inertia m="0.05" r="0.02" h="0.01"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.01"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <visual>
            <origin xyz="0 0 ${-(gps_post/2 + 0.005)}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.005" length="${gps_post}"/>
            </geometry>
            <material name="gray"/>
        </visual>
    </link>

</robot>
