        <visual>
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
            <material name="green"/>
        </visual>
        <visual>
            <origin xyz="0.035 0 0" rpy="0 ${pi/2} 0"/>
            <geometry>
                <cylinder radius="0.015" length="0.02"/>
            </geometry>
            <material name="green"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
        </collision>
        <collision>
            <origin xyz="0.035 0 0" rpy="0 ${pi/2} 0"/>
