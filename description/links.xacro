<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- =========================================== -->
    <!-- =============== CHASSIS ================= -->
    <!-- =========================================== -->
    <link name="base_link">
        <inertial>
            <origin xyz="0.000973 0.000007 0.486096" rpy="0 0 0"/>
      	    <mass value="185.1322568023575"/>
      	    <inertia ixx="11.056144" iyy="30.914741" izz="38.217336" ixy="0.00074" ixz="0.00702" iyz="-0.000207"/>
    	</inertial>
    	<visual>
    	    <origin xyz="0.000973 0.000007 0.486096" rpy="0 0 0"/>
            <geometry>
                <box size="1.35 0.75 0.30"/>
            </geometry>
            <material name="desert_tan"/>
        </visual>
        <collision>
            <origin xyz="0.000973 0.000007 0.486096" rpy="0 0 0"/>
            <geometry>
                <box size="1.35 0.75 0.30"/>
            </geometry>
        </collision>
    </link>
    
    <!-- =========================================== -->
