    <!-- =========================================== -->
    <!-- ========== FRONT MONO CAMERA ============== -->
    <!-- =========================================== -->
    <link name="f_camera_link">
        <inertial>
            <origin xyz="0 0 0.0225" rpy="0 0 0"/>
            <mass value="0.5186547939422563"/>
            <inertia ixx="0.000946" iyy="0.00017" izz="0.000952" ixy="0.0" iyz="0.0" ixz="0.0"/>
