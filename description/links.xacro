        </collision>
  </link>

    <!-- Optical frames (REP-103: z forward, x right, y down). Empty frames;
         images/camera_info are stamped with these so VSLAM gets the right axes. -->
    <link name="f_camera_optical_link"/>
    <link name="r_camera_optical_link"/>

    <!-- =========================================== -->
    <!-- ================== IMU ==================== -->
    <!-- =========================================== -->
    <link name="imu_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.05"/>
            <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0.0" iyz="0.0" ixz="0.0"/>
        </inertial>
    </link>

    <!-- =========================================== -->
    <!-- ================== GPS ==================== -->
    <!-- =========================================== -->
    <link name="gps_link">
        <inertial>
            <origin xyz="0 0 0.01" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="2e-5" iyy="2e-5" izz="2e-5" ixy="0.0" iyz="0.0" ixz="0.0"/>
