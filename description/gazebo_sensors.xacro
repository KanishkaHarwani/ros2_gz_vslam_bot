<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- =========================================== -->
    <!-- ============ STEREO CAMERA PAIR =========== -->
    <!-- =========================================== -->
    <!-- Plain `camera` sensors (not the combined rgbd_camera), which avoids
         the ogre2 corruption bug from ros_gz#738. Image/camera_info headers
         use the optical frame. Left camera is always on; the right one is
         dropped when launched with stereo_mode:=mono. -->
    <xacro:macro name="camera_sensor" params="side">
        <gazebo reference="cam_${side}_link">
            <sensor name="cam_${side}" type="camera">
                <always_on>true</always_on>
                <visualize>${sensor_visualize}</visualize>
                <update_rate>${camera_rate}</update_rate>
                <topic>camera/${side}/image</topic>
                <gz_frame_id>cam_${side}_optical_frame</gz_frame_id>
                <camera name="cam_${side}">
                    <horizontal_fov>${camera_hfov}</horizontal_fov>
                    <image>
                        <width>${camera_width}</width>
                        <height>${camera_height}</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>30.0</far>
                    </clip>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>${camera_noise_stddev}</stddev>
                    </noise>
                    <camera_info_topic>camera/${side}/camera_info</camera_info_topic>
                </camera>
            </sensor>
        </gazebo>
    </xacro:macro>

    <xacro:camera_sensor side="left"/>

    <xacro:if value="$(arg enable_right_camera)">
        <xacro:camera_sensor side="right"/>
    </xacro:if>

    <!-- =========================================== -->
    <!-- ==================== IMU ================== -->
    <!-- =========================================== -->
    <!-- Needs the Imu system plugin in the world file. -->
    <gazebo reference="imu_link">
        <sensor name="imu" type="imu">
            <always_on>true</always_on>
            <visualize>false</visualize>
            <update_rate>${imu_rate}</update_rate>
            <topic>imu</topic>
            <gz_frame_id>imu_link</gz_frame_id>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <!-- =========================================== -->
    <!-- ==================== GPS ================== -->
    <!-- =========================================== -->
    <!-- Toggle with enable_gps:=true. Meaningless in indoor worlds (no sky
         view); intended for outdoor/yard-style maps. Needs the NavSat system
         plugin and <spherical_coordinates> in the world file. -->
    <xacro:if value="$(arg enable_gps)">
        <gazebo reference="gps_link">
            <sensor name="navsat" type="navsat">
                <always_on>true</always_on>
                <update_rate>${gps_rate}</update_rate>
                <topic>navsat</topic>
                <gz_frame_id>gps_link</gz_frame_id>
            </sensor>
        </gazebo>
    </xacro:if>

</robot>
