<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo reference="base_link">
        <material>
            <ambient>0.820 0.710 0.550 1.000</ambient>
            <diffuse>0.820 0.710 0.550 1.000</diffuse>
        </material>
    </gazebo>

    <!-- Anisotropic wheel friction: mu1 (fdir1 = rolling direction, local X)
         kept high for straight-line traction; mu2 (lateral, local Y) lowered
         so wheels can slide sideways during a skid-steer pivot without
         stick-slip. kp/kd are ODE-only (ignored by DART, the Harmonic
         default engine) and kept only in case you switch engines. Starting values — tune mu2 down further (e.g. 0.15)
         if rocking persists, or up if the robot starts sliding out during
         normal turns. -->
    <gazebo reference="l_f_wheel_link">
        <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
        </material>
        <mu1>1.0</mu1>
        <mu2>0.3</mu2>
        <fdir1>1 0 0</fdir1>
        <kp>1e6</kp>
        <kd>10</kd>
    </gazebo>
    <gazebo reference="l_r_wheel_link">
        <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
        </material>
        <mu1>1.0</mu1>
        <mu2>0.3</mu2>
        <fdir1>1 0 0</fdir1>
        <kp>1e6</kp>
        <kd>10</kd>
    </gazebo>
    <gazebo reference="r_f_wheel_link">
        <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
        </material>
        <mu1>1.0</mu1>
        <mu2>0.3</mu2>
        <fdir1>1 0 0</fdir1>
        <kp>1e6</kp>
        <kd>10</kd>
    </gazebo>
    <gazebo reference="r_r_wheel_link">
        <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
        </material>
        <mu1>1.0</mu1>
        <mu2>0.3</mu2>
        <fdir1>1 0 0</fdir1>
        <kp>1e6</kp>
        <kd>10</kd>
    </gazebo>

    <gazebo reference="front_bumper_link">
        <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
        </material>
    </gazebo>
    <gazebo reference="rear_bumper_link">
        <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
        </material>
    </gazebo>

    <gazebo reference="f_camera_link">
        <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
        </material>
    </gazebo>
    <gazebo reference="r_camera_link">
        <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
        </material>
    </gazebo>

    <gazebo reference="gps_link">
        <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
        </material>
    </gazebo>

</robot>
