<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo reference="base_link">
        <material>
            <ambient>0.820 0.710 0.550 1.000</ambient>
            <diffuse>0.820 0.710 0.550 1.000</diffuse>
        </material>
    </gazebo>

    <!-- Drive wheels: with only two driven wheels + a caster there is no
         skid-steer scrubbing, so lateral friction should be HIGH (mu2 = mu1).
         The anisotropic low-mu2 setting from the 4-wheel bot would let the
         small robot slide sideways. kp/kd soften contact slightly. -->
    <xacro:macro name="wheel_surface" params="prefix">
        <gazebo reference="${prefix}_wheel_link">
            <material>
                <ambient>0 0 0 1</ambient>
                <diffuse>0 0 0 1</diffuse>
            </material>
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
            <kp>1e6</kp>
            <kd>1.0</kd>
        </gazebo>
    </xacro:macro>
    <xacro:wheel_surface prefix="l"/>
    <xacro:wheel_surface prefix="r"/>

    <!-- Caster: near-frictionless so it never drags or biases turns. -->
    <gazebo reference="caster_link">
        <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
    </gazebo>

    <gazebo reference="stereo_bar_link">
        <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
    </gazebo>

    <gazebo reference="cam_left_link">
        <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
        </material>
    </gazebo>
    <gazebo reference="cam_right_link">
        <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
        </material>
    </gazebo>

    <gazebo reference="imu_link">
        <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
        </material>
    </gazebo>

    <gazebo reference="gps_link">
        <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
        </material>
    </gazebo>

</robot>
